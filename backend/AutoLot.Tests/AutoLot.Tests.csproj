<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoLot.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />

    <!--
      Піднімає застосунок у пам'яті разом із усім його конвеєром: маршрутизацією,
      фільтрами, автентифікацією, обробником помилок. HttpClient від нього ходить
      без мережі, тож тести лишаються швидкими, а перевіряють справжні відповіді —
      коди, заголовки, JSON.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

    <!--
      Клієнт живого каналу. Тим самим способом, яким підключається браузер,
      тест підключається до хаба на тестовому сервері й перевіряє, що новина
      справді доходить — а не лише що сервіс «викликав розсилку».
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoLot.Api\AutoLot.Api.csproj" />
    <ProjectReference Include="..\AutoLot.Application\AutoLot.Application.csproj" />
    <ProjectReference Include="..\AutoLot.Domain\AutoLot.Domain.csproj" />
    <ProjectReference Include="..\AutoLot.Infrastructure\AutoLot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
