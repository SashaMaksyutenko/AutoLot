# Налаштування для docker-compose.yml. Скопіюйте у .env і заповніть.
# Сам .env у репозиторій не потрапляє (див. .gitignore).
#
# Коли застосунок запускають локально через dotnet run, з цього файла
# потрібен лише пароль бази: решта живе в user-secrets.

# ── База ──────────────────────────────────────────────────────────────
POSTGRES_DB=autolot
POSTGRES_USER=autolot
POSTGRES_PASSWORD=

# ── Застосунок у контейнері ───────────────────────────────────────────

# Ключ, яким підписуються токени входу. Щонайменше 32 символи, і чим
# випадковіші, тим краще: хто знає цей ключ, той може виписати собі токен
# від імені будь-кого. Згенерувати:
#   openssl rand -base64 48
JWT_KEY=

# Перший адміністратор. Без цих двох значень сід його не створює, і зайти
# в адмінку не зможе ніхто. Пароль має відповідати вимогам Identity:
# від восьми символів, з великою літерою, цифрою та розділовим знаком.
ADMIN_EMAIL=admin@autolot.local
ADMIN_PASSWORD=

# Адреса, за якою сайт видно ззовні. Потрапляє в листи, sitemap.xml і теги
# для месенджерів, тож на справжньому хостингу її треба замінити.
SITE_URL=http://localhost:8080
